CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_FEATURE_SYSTEM_CORE=y
CONFIG_FEATURE_MODULE_REGISTRY=y
CONFIG_FEATURE_VERSION_INFO=y
CONFIG_FEATURE_ERROR_CODE=y
CONFIG_FEATURE_DEVICE_IDENTITY=y
CONFIG_FEATURE_DEVICE_CAPABILITIES=y
# Shared security and child safety baseline. Transport validation, guardian
# consent, and content moderation are part of every production image.
CONFIG_FEATURE_TRANSPORT_SECURITY=y
CONFIG_FEATURE_PRIVACY_GUARD=y
CONFIG_FEATURE_CONTENT_FILTER=y
CONFIG_FEATURE_ERROR_RECOVERY=y
CONFIG_FEATURE_CONFIG_STORE=y
CONFIG_FEATURE_NETWORK_MANAGER=y
CONFIG_FEATURE_DEVICE_BINDING_CLIENT=y
CONFIG_FEATURE_DEVICE_PROVISIONING=y
CONFIG_FEATURE_PROVISIONING_PAYLOAD=y
CONFIG_FEATURE_PARENT_POLICY=y
# Parent control enforcement ships with its local usage ledger so every
# consumption path (wake, voice, content, playback queue) shares one decision
# layer and the platform receives the billable usage it produces.
CONFIG_FEATURE_USAGE_LEDGER=y
CONFIG_FEATURE_PARENT_CONTROL_RUNTIME=y
CONFIG_FEATURE_DIAGNOSTIC_REPORTER=y
CONFIG_FEATURE_PROVISIONING_REPORTER=y
# Realtime voice conversation. voice_session owns the WSS transport and drives
# the listening -> thinking -> speaking loop, conversation_context keeps a
# bounded on-device turn window, and child_prompt_profile persists the age
# tier and guardian content level. All three ship in the product profile.
CONFIG_FEATURE_AUDIO_INPUT=y
CONFIG_FEATURE_VOICE_WAKE=y
CONFIG_FEATURE_AUDIO_OUTPUT=y
CONFIG_FEATURE_VOICE_SESSION=y
CONFIG_FEATURE_CONVERSATION_CONTEXT=y
CONFIG_FEATURE_CHILD_PROMPT_PROFILE=y
CONFIG_FEATURE_CONTENT_LIBRARY=y
CONFIG_FEATURE_CONTENT_DOWNLOADER=y
CONFIG_FEATURE_CONTENT_PACKAGE_MANAGER=y
CONFIG_FEATURE_OTA_VALIDATE=y
CONFIG_FEATURE_OTA_DOWNLOAD=y
CONFIG_FEATURE_OTA_ROLLBACK=y
CONFIG_FEATURE_OTA_MANAGER=y
CONFIG_OTA_MANAGER_CHANNEL="stable"
CONFIG_OTA_MANAGER_HARDWARE_REVISION="esp32s3"
CONFIG_OTA_ROLLBACK_MAX_BOOT_ATTEMPTS=3
CONFIG_FEATURE_WAKE_FEEDBACK=y
CONFIG_FEATURE_LED_INDICATOR=y
CONFIG_FEATURE_BUTTON_INPUT=y
CONFIG_FEATURE_FACTORY_RESET=y
CONFIG_MODULE_REGISTRY_CAPACITY=64

# Local wake detection uses ESP-SR WakeNet in production. The model lives in
# its own flash partition so OTA updates of the application do not rewrite it.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# Platform HTTPS endpoint is defined by the device_binding_client Kconfig
# default (https://api.clarkhub.cn), so releases cannot silently ship an
# empty or cleartext endpoint.

# BLE provisioning uses NimBLE and Security 2. On first boot the device
# generates a unique proof of possession and SRP verifier into encrypted NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y

# Optional feature modules are disabled unless a product profile enables them.
# CONFIG_FEATURE_UI_TEXT is not set
