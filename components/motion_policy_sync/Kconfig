menu "Sprout feature modules"

config FEATURE_MOTION_POLICY_SYNC
    bool "Enable motion policy synchronisation"
    default y
    depends on FEATURE_MOTION_CONTROL && FEATURE_DEVICE_BINDING_CLIENT && FEATURE_NETWORK_MANAGER && FEATURE_TIME_SYNC
    help
        Fetches the family motion policy and applies it, keeping a device's
        speed, runtime, stop-grace and locomotion policy consistent with the
        parent app.

config MOTION_POLICY_SYNC_INTERVAL_SECONDS
    int "Motion policy sync interval in seconds"
    depends on FEATURE_MOTION_POLICY_SYNC
    range 60 86400
    default 1800

config MOTION_POLICY_SYNC_RETRY_INTERVAL_SECONDS
    int "Motion policy sync retry interval while offline"
    depends on FEATURE_MOTION_POLICY_SYNC
    range 5 300
    default 15

endmenu
