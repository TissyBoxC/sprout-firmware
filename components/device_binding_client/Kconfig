menu "Sprout feature modules"

config FEATURE_DEVICE_BINDING_CLIENT
    bool "Enable device binding client"
    default y
    depends on FEATURE_CONFIG_STORE && FEATURE_DEVICE_IDENTITY
    help
        Contacts device_platform to register this device, prove its identity
        with an ECDSA challenge, request a single-use binding token, and detect
        when a guardian completes binding.

config DEVICE_BINDING_PLATFORM_BASE_URL
    string "Device platform HTTPS base URL"
    depends on FEATURE_DEVICE_BINDING_CLIENT
    default ""
    help
        Base URL of device_platform. Must use HTTPS so certificate validation
        stays enabled.

config DEVICE_BINDING_HARDWARE_MODEL
    string "Hardware model reported during registration"
    depends on FEATURE_DEVICE_BINDING_CLIENT
    default "sprout-s3-n16r8"
    help
        Capability-oriented hardware model name sent to device_platform. It
        must not contain a character, product-shape, or SKU codename.

endmenu
