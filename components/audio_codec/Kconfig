menu "Sprout feature modules"

config FEATURE_AUDIO_CODEC
    bool "Enable realtime audio codec"
    default y
    help
        Encode captured microphone PCM into Opus packets and decode inbound
        Opus packets into PCM for the speaker. The gateway and the firmware
        share one fixed profile: 16 kHz, mono, 20 ms Opus frames.

config AUDIO_CODEC_BITRATE
    int "Encoder target bitrate in bits per second"
    depends on FEATURE_AUDIO_CODEC
    range 6000 64000
    default 24000

config AUDIO_CODEC_COMPLEXITY
    int "Opus encoder complexity"
    depends on FEATURE_AUDIO_CODEC
    range 0 10
    default 3
    help
        Lower complexity reduces CPU and current draw on the S3 while keeping
        wideband speech intelligible.

config AUDIO_CODEC_ENABLE_DTX
    bool "Enable discontinuous transmission"
    depends on FEATURE_AUDIO_CODEC
    default n
    help
        DTX suppresses silent frames. Keep it off for the first hardware
        profile so the sequence timeline stays dense and easy to diagnose.

endmenu
