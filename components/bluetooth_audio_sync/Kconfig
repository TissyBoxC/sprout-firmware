menu "Sprout feature modules"

config FEATURE_BLUETOOTH_AUDIO_SYNC
    bool "Enable Bluetooth audio policy synchronisation"
    default y
    depends on FEATURE_BLUETOOTH_AUDIO && FEATURE_DEVICE_BINDING_CLIENT && FEATURE_NETWORK_MANAGER && FEATURE_TIME_SYNC
    help
        Fetches the family Bluetooth audio policy and applies it, keeping a
        device's speaker, pairing, codec and volume ceiling consistent with the
        parent app.

config BLUETOOTH_AUDIO_SYNC_INTERVAL_SECONDS
    int "Bluetooth audio policy sync interval in seconds"
    depends on FEATURE_BLUETOOTH_AUDIO_SYNC
    range 60 86400
    default 1800

config BLUETOOTH_AUDIO_SYNC_RETRY_INTERVAL_SECONDS
    int "Bluetooth audio policy sync retry interval while offline"
    depends on FEATURE_BLUETOOTH_AUDIO_SYNC
    range 5 300
    default 15

endmenu
